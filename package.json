{
  "name": "@naylence/advanced-security",
  "version": "0.3.14",
  "type": "module",
  "description": "Advanced security utilities for the Naylence Fame runtime implemented in TypeScript.",
  "author": "Naylence Dev <naylencedev@gmail.com>",
  "license": "BUSL-1.1",
  "keywords": [
    "naylence",
    "fame",
    "security",
    "agents",
    "encryption",
    "certificates",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/naylence/naylence-advanced-security-ts"
  },
  "bugs": {
    "url": "https://github.com/naylence/naylence-advanced-security-ts/issues"
  },
  "homepage": "https://github.com/naylence/naylence-advanced-security-ts#readme",
  "main": "dist/node/node.cjs",
  "module": "dist/node/node.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "browser": {
        "import": "./dist/browser/index.mjs",
        "require": "./dist/browser/index.cjs",
        "default": "./dist/browser/index.mjs"
      },
      "import": "./dist/node/node.mjs",
      "require": "./dist/node/node.cjs",
      "default": "./dist/node/node.mjs"
    },
    "./node": {
      "types": "./dist/types/node.d.ts",
      "import": "./dist/node/node.mjs",
      "require": "./dist/node/node.cjs"
    },
    "./browser": {
      "types": "./dist/types/browser.d.ts",
      "import": "./dist/browser/index.mjs",
      "require": "./dist/browser/index.cjs"
    },
    "./install-env": {
      "types": "./dist/types/install-env.d.ts",
      "import": "./dist/esm/install-env.js",
      "require": "./dist/cjs/install-env.js",
      "default": "./dist/esm/install-env.js"
    },
    "./factory-manifest": {
      "types": "./dist/types/naylence/fame/factory-manifest.d.ts",
      "import": "./dist/esm/naylence/fame/factory-manifest.js",
      "require": "./dist/cjs/naylence/fame/factory-manifest.js",
      "default": "./dist/esm/naylence/fame/factory-manifest.js"
    },
    "./register-advanced-security-factories": {
      "types": "./dist/types/naylence/fame/security/register-advanced-security-factories.d.ts",
      "import": "./dist/esm/naylence/fame/security/register-advanced-security-factories.js",
      "require": "./dist/cjs/naylence/fame/security/register-advanced-security-factories.js",
      "default": "./dist/esm/naylence/fame/security/register-advanced-security-factories.js"
    },
    "./plugin": {
      "types": "./dist/types/plugin.d.ts",
      "import": "./dist/esm/plugin.js",
      "require": "./dist/cjs/plugin.js",
      "default": "./dist/esm/plugin.js"
    },
    "./*": {
      "types": "./dist/types/*",
      "import": "./dist/esm/*",
      "require": "./dist/cjs/*",
      "default": "./dist/esm/*"
    }
  },
  "browser": {
    "./dist/node/index.mjs": "./dist/browser/index.mjs",
    "./dist/node/index.cjs": "./dist/browser/index.cjs",
    "fastify": false,
    "@fastify/websocket": false,
    "@fastify/formbody": false,
    "better-sqlite3": false,
    "express": false,
    "pino": false,
    "pino-pretty": false,
    "fs": false,
    "readline": false,
    "crypto": false,
    "ws": false,
    "node:net": false,
    "node:module": false,
    "node:fs": false,
    "node:fs/promises": false,
    "node:path": false,
    "node:crypto": false,
    "node:url": false,
    "node:http": false,
    "node:https": false,
    "node:os": false
  },
  "sideEffects": [
    "**/*-factory.ts",
    "**/*-factory.js",
    "**/storage/index.ts",
    "**/storage/index.js",
    "dist/browser/index.mjs",
    "dist/browser/index.cjs"
  ],
  "bin": {
    "naylence-ca-server": "./dist/esm/naylence/fame/security/cert/ca-server-cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:types && npm run build:cjs && npm run build:esm && npm run build:browser",
    "build:types": "tsc --emitDeclarationOnly --outDir dist/types",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:browser": "rollup -c rollup.config.js",
    "clean": "rimraf dist",
    "generate:factory-manifest": "node ./scripts/generate-factory-manifest.mjs",
    "inject-version": "node ./scripts/inject-version.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:vitest": "vitest run",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "dev": "tsc --watch --outDir dist/esm",
    "prebuild": "npm run inject-version && npm run generate:factory-manifest",
    "predev": "npm run inject-version && npm run generate:factory-manifest",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@naylence/runtime": "^0.3.12",
    "@noble/ciphers": "^2.0.1",
    "@noble/curves": "^1.4.0",
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.4.0",
    "@peculiar/asn1-csr": "^2.5.0",
    "@peculiar/asn1-schema": "^2.5.0",
    "@peculiar/asn1-x509": "^2.5.0",
    "@peculiar/x509": "^1.14.0",
    "fastify": "^5.6.1",
    "jose": "^6.1.0",
    "yaml": "^2.6.0",
    "zod": "^4.1.11"
  },
  "peerDependencies": {
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.205.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-trace-base": "^2.1.0",
    "@opentelemetry/sdk-trace-node": "^2.1.0",
    "better-sqlite3": "^12.4.1",
    "pino": "^9.12.0",
    "pino-pretty": "^13.1.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.7.2",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "prettier": "^3.1.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.52.3",
    "ts-jest": "^29.4.4",
    "tslib": "^2.6.2",
    "typescript": "^5.3.2",
    "vitest": "^2.1.4",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
